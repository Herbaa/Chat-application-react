generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url = "file:./dev.db"
}

model Message {
  id        Int      @id @default(autoincrement())
  username  String
  text      String
  createdAt DateTime @default(now())
}